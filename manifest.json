{
  "manifest_version": 3,
  "name": "STSWR School Lookup",
  "version": "1.0.0",
  "description": "Lookup school eligibility on Student Transportation Services of Waterloo Region",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": [
    "https://bpweb.stswr.ca/*",
    "https://www.compareschoolrankings.org/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
